// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "relative_line_numbers": "wrapped",
  "lsp": {
    "nixd": {
      "settings": {
        "nixd": {
          "options": {
            "nixos": {
              "expr": "(builtins.getFlake \"/home/noah/nixos/desktop\").nixosConfigurations.desktop.options"
            },
            "home-manager": {
              "expr": "(builtins.getFlake \"/home/noah/nixos/desktop\").nixosConfigurations.desktop.options.home-manager.users.type.getSubOptions []"
            }
          }
        }
      }
    }
  },
  "git_panel": {
    "tree_view": false
  },
  "ssh_connections": [
    {
      "host": "minecraft",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/minecraft"
          ]
        }
      ]
    }
  ],
  "cli_default_open_behavior": "existing_window",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "plan"
      },
      "type": "registry"
    }
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Noctalia Light Transparent",
    "dark": "Noctalia Dark Transparent",
  },
}
