//
// Window rules let you adjust behavior for individual windows.
// Find more information on the wiki:
// https://github.com/niri-wm/niri/wiki/Configuration:-Window-Rules
//


// Example: block out two password managers from screen capture.
// (This example rule is commented out with a "/-" in front.)
/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"

    // Use this instead if you want them visible on third-party screenshot tools.
    // block-out-from "screencast"
}

// Example: enable rounded corners for all windows.
// (This example rule is commented out with a "/-" in front.)
/-window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

//No window title bars
prefer-no-csd




// Global / default WIndow Rules
window-rule {
  // Rounded corners for a modern look.
  geometry-corner-radius 20

  // Clips window contents to the rounded corner boundaries.
  clip-to-geometry true

  opacity 0.9
  draw-border-with-background false

  background-effect {
    blur true
    xray true
  }
}

blur {
  passes 2
  offset 3
  noise 0.05
  saturation 1.5
}

// Minecraft: float, 75% of screen. Regex on app-id survives version bumps (app-id is "Minecraft* <ver>").
window-rule {
    match app-id=r#"^Minecraft"#
    open-floating true
    default-column-width { proportion 0.85; }
    default-window-height { proportion 0.95; }
    opacity 1.0
}

// Work around WezTerm's initial configure bug
// by setting an empty default-column-width.
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// blur Overview
layer-rule {
  match namespace="^noctalia-overview*"
  match namespace="^noctalia-backdrop"
  place-within-backdrop true
}

layer-rule {
  match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel)$"
  //opacity 0.75
  background-effect {
    xray false
    //blur false
  }
}

//
// No Blur
//
window-rule {
    match app-id="dev.zed.Zed"
    match app-id=r#"^Minecraft.*"#
    match app-id="" title=".*YouTube.*"
    match title="Netflix.*"
    match app-id="^jellyfin-desktop$"
    match app-id="^org.jellyfin.JellyfinDesktop$"
    match app-id="^steam$" title="^Steam$"
    match app-id="^imv$"

    opacity 1.0
    background-effect {
        blur false
        xray false
    }
}

//
// Steam
//

// Dont Float, Fullscreen
window-rule {
  // Main window
  match app-id="^steam$" title="^Steam$"
  open-floating false
  open-fullscreen true
}

// Other windows Friends, Chat,
// window-rule {
//   match app-id="^steam$"
//   exclude title="^steam$"
//   open-fullscreen false
//   open-floating false
//   background-effect {
//     xray false
//   }
// }

//Floating mini
window-rule {
    match app-id="steam" title=r#"^Chat .*$"#
    match title="Shawn"
    open-floating true
    default-floating-position x=20 y=40 relative-to="top-right"
}

//Steam Keyboard
window-rule {
    match app-id="steam" title="^Steam Input On-screen Keyboard$"
    open-floating true
    opacity 1.0
}

// Games Monitor
window-rule {
    // Match Steam games (launched via Steam Runtime)
    match app-id=r#"^steam_app_\d+$"#
    match app-id="^Slay the Spire 2$"
    match app-id="^cs2$"
    open-fullscreen true

    open-on-output "Microstep MPG341CX OLED Unknown"
    // VRR
    variable-refresh-rate true

    // Opacity (adjust values as needed)
    opacity 1.0
}

// Files App
window-rule {
  match app-id="^org.gnome.Nautilus$"
  opacity 0.65
  background-effect {
    blur true
    xray true
  }
}

// No X-ray, No, Blur
window-rule {
  match app-id="^Alacritty$"
  opacity 0.9
  background-effect {
    blur false //see the text behind
    xray false // Don't skip to desktop layer
  }
}

//Notification/Status indicators
window-rule {
  match title="^notificationtoasts*" //Steam notification toasts
  open-floating true
  open-focused false
  default-floating-position x=0 y=0 relative-to="top-right"

}

// Open picture-in-picture players as small floating windows.
window-rule {
    match title="^Picture-in-Picture$"
    open-floating true
    default-column-width { proportion 0.25; }
    // 25% width on the 3440x1440 ultrawide, with a 16:9 video frame.
    default-window-height { proportion 0.336; }
    default-floating-position x=0 y=0 relative-to="bottom-right"
    opacity 1.0
}


// Floating Noctalia settings window.
window-rule {
  match app-id="dev.noctalia.Noctalia.Settings"
  open-floating true
  default-column-width { fixed 1080; }
  default-window-height { fixed 920; }
}

// Pavucontrol (GTK mixer) — floating, fixed size, translucent with windows visible behind
window-rule {
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    open-floating true
    default-column-width { fixed 1200; }
    default-window-height { fixed 1100; }
    opacity 0.75
    background-effect {
        blur true
        xray false
    }
}

debug {
  // Allows notification actions and window activation from Noctalia.
  honor-xdg-activation-with-invalid-serial
}
