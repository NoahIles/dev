layout {

    focus-ring {
        active-color   "#fff59b"
        inactive-color "#000000"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#fff59b"
        inactive-color "#000000"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#fff59b"
        inactive-color "#514e46"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#fff59b80"
    }
}

recent-windows {
    highlight {
        active-color "#fff59b"
        urgent-color "#fd4663"
    }
}
