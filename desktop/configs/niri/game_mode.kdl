// game mode niri settings overide

layout {
    gaps 0

  border {
	  on
	  width 1
	  active-color "#6d00e4"
	  inactive-color "#000000"
	  urgent-color "#fd4663"
  }
  focus-ring {
    off
    width 1
    active-color "#6d00e4"
    inactive-color "#6d00e4"
    //active-gradient to="#80c8ff" from="#c7ff7f" angle=100
  }

  tab-indicator {
      //off
      hide-when-single-tab
      place-within-column
      gap 0
      width 5
      length total-proportion=1.0
      active-color "#ffffff"
      inactive-color "#000000"
      position "right"


  }
}

window-rule {
  geometry-corner-radius 0
  opacity 1.0
}
